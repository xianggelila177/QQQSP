{
  "name": "qqqsp-v2",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "单用户、零依赖的多市场行情面板",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node tests/run.mjs",
    "test:core": "node --test tests/v2/*.test.mjs",
    "test:browser": "python3 tests/v2/browser_check.py",
    "test:legacy": "node tests/_run_all.mjs",
    "check": "node scripts/verify.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm test",
    "test:charts": "python3 tests/v2/chart_browser_check.py",
    "test:futures-browser": "python3 tests/v2/futures_browser_check.py",
    "test:macro-browser": "python3 tests/v2/macro_browser_check.py"
  }
}
